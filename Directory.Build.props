<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This repository exists because unnoticed build warnings cost real time, so it does not
         get to have any of its own. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>John Zabroski</Authors>
    <Company>Fluent Foundation</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fluentfoundation/redecker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fluentfoundation/redecker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Symbols and source stepping. SourceLink is in the SDK from .NET 8 onwards, so this
         needs no package reference. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Deterministic output when building in CI; the release workflow sets this explicitly
         too, so a local build and a CI build of the same commit agree. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Shared package presentation, so every package under the Redecker* prefix carries the same
       identity. nuget.org's ID prefix reservation criteria ask for exactly this consistency, and
       for an embedded icon rather than the deprecated iconUrl. -->
  <PropertyGroup>
    <PackageIcon>redecker-icon-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inert in projects that are not packable. NuGet requires a raster icon; the SVG beside
         these is the source, kept for editing rather than for packing. -->
    <None Include="$(MSBuildThisFileDirectory)assets/redecker-icon-128.png"
          Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
