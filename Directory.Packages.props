<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <PackageVersion Include="NuGet.Versioning" Version="7.6.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.6.0" />
    <!-- Held deliberately low, and never shipped. A task assembly is loaded into whatever
         MSBuild is hosting it, so it must compile against the oldest MSBuild it claims to
         support; that host then supplies the real assembly at run time.
         17.8.43 rather than 17.8.3: the 17.8 line before .43 is affected by CVE-2025-55247
         (GHSA-w3q9-fxm7-j8fq), which this repository's own audit caught on the first build. -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.8.43" />
  </ItemGroup>

  <ItemGroup Label="test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.1.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.0" />
  </ItemGroup>

</Project>
