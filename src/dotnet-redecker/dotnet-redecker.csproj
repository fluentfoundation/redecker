<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Redecker.Cli</RootNamespace>
    <AssemblyName>dotnet-redecker</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>redecker</ToolCommandName>
    <PackageId>dotnet-redecker</PackageId>
    <PackageOutputPath>../../artifacts/packages</PackageOutputPath>
    <Description>
      An update tool for .NET dependencies that reads packages rather than just their version
      graph, and treats the reason a pin exists as machine-readable data.
    </Description>
    <PackageTags>nuget;dependencies;updates;dependabot;msbuild</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Tools are run by whatever runtime the user happens to have. -->
    <RollForward>major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown on the nuget.org listing page. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Redecker.Core/Redecker.Core.csproj" />
  </ItemGroup>

</Project>
