<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ratchet.Cli</RootNamespace>
    <AssemblyName>dotnet-ratchet</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ratchet</ToolCommandName>
    <PackageId>dotnet-ratchet</PackageId>
    <PackageOutputPath>../../artifacts/packages</PackageOutputPath>
    <Description>
      An update tool for .NET dependencies that reads packages rather than just their version
      graph, and treats the reason a pin exists as machine-readable data.
    </Description>
    <PackageTags>nuget;dependencies;updates;dependabot;msbuild</PackageTags>

    <!-- Tools are run by whatever runtime the user happens to have. -->
    <RollForward>major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ratchet.Core/Ratchet.Core.csproj" />
  </ItemGroup>

</Project>
