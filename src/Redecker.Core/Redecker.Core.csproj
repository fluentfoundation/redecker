<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Redecker</RootNamespace>
    <!-- The tool is the deliverable, and it bundles this assembly. Publishing the library
         separately would commit to its API before the rule set has settled; flip this to true
         when that surface is worth supporting for other callers. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" />
    <!-- Framework folder names are a small language with a long tail, and their compatibility
         rules are not derivable from the names: netstandard has a fallback chain, PCL profiles
         are set intersections, and uap10.0 means .NETCore,Version=v5.0. Restore already knows all
         of it, so RDK0010 asks NuGet the same question restore asks rather than re-deriving it. -->
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Path resolution is the part of DanglingAssetRule most worth testing directly, but it is
         an implementation detail rather than something callers should depend on. -->
    <InternalsVisibleTo Include="Redecker.Core.Tests" />
  </ItemGroup>

</Project>
