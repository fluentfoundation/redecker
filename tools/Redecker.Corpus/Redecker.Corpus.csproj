<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Redecker.Corpus</RootNamespace>
    <!-- Internal tooling: never shipped, never referenced by anything that is. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Redecker.Core/Redecker.Core.csproj" />
    <!-- Framework folder names are a small language with a long tail — profiles, platform
         suffixes, MonoAndroid, PCL. NuGet's own parser is the only correct implementation, and
         a survey that gets the parsing wrong measures its own bugs. -->
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>

</Project>
